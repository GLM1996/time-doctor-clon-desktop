{
  "manifest_version": 3,
  "name": "LogYourTime Website Tracking",
  "version": "1.0.0",
  "description": "Envía únicamente el dominio de la pestaña activa a la aplicación LogYourTime instalada en este equipo.",
  "key": "",
  "permissions": ["tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1:32145/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "LogYourTime Website Tracking",
    "default_icon": "icon.png"
  }
}
