{
  "name": "log-your-time",
  "version": "1.2.2",
  "description": "Aplicación de escritorio para monitoreo de tiempo",
  "main": "./out/main/index.js",
  "type": "module",
  "author": "Gustavo Leon",
  "build": {
    "appId": "com.homelasvegasnevada.logyourtime",
    "productName": "LogYourTime",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "browser-extension",
        "to": "browser-extension",
        "filter": ["**/*"]
      },
      {
        "from": "native",
        "to": "native",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "verifyUpdateCodeSignature": true,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LogYourTime"
    },
    "publish": {
      "provider": "generic",
      "url": "https://downloads.logyourtime.com/windows/"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "postinstall": "electron-builder install-app-deps",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "node --test --test-concurrency=1",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=35 --test-coverage-functions=90 --test-concurrency=1",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "release:verify": "node scripts/verify-release-artifacts.mjs",
    "release": "npm run test && npm run build && electron-builder --win --publish always && npm run release:verify",
    "release:draft": "npm run test && npm run build && electron-builder --win --publish onTagOrDraft && npm run release:verify"
  },
  "dependencies": {
    "axios": "^1.8.1",
    "better-sqlite3": "^12.11.1",
    "electron-log": "^5.3.0",
    "electron-store": "^10.0.1",
    "electron-updater": "^6.3.9",
    "form-data": "^4.0.6",
    "get-windows": "^9.3.0",
    "keyspy": "^1.1.1",
    "lucide-react": "^1.24.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "postcss": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.0"
  }
}
